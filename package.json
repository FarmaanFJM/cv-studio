{
  "name": "cv-studio",
  "version": "3.2.0",
  "description": "CV Studio, offline Windows-cv-builder voor precies één A4-pagina",
  "author": "FarmaanFJM",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "gen:icons": "node scripts/gen-brand-icons.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "test:e2e:linux": "npm run build && xvfb-run -a node e2e/run.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "licenses": "node scripts/collect-licenses.mjs",
    "gen:logo": "python3 scripts/gen-logo-assets.py",
    "verify:exe": "node scripts/verify-exe.mjs"
  },
  "build": {
    "appId": "nl.cvstudio.app",
    "productName": "CV Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CV Studio"
    },
    "artifactName": "CV-Studio-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "build/icon.ico",
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "FarmaanFJM",
        "repo": "cv-studio",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © FarmaanFJM. MIT License."
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/work-sans": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "devicon": "^2.17.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "feather-icons": "^4.29.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.0",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/FarmaanFJM/cv-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarmaanFJM/cv-studio.git"
  },
  "bugs": {
    "url": "https://github.com/FarmaanFJM/cv-studio/issues"
  },
  "keywords": [
    "cv-builder",
    "resume-builder",
    "electron",
    "react",
    "typescript",
    "pdf",
    "windows",
    "offline-first"
  ],
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
